<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Illux.ImageTool.Settings.HelpWindow"
        Title="AE parameter help"
        Width="720" Height="520" MinWidth="400" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" Height="32" IsCancel="True"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4" />
    <TextBox x:Name="Body" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Consolas, Menlo, monospace" FontSize="13"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
