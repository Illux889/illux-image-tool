<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Illux.ImageTool.Settings.RuleWindow"
        Title="Add rule"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Styles>
  <Grid Margin="12" ColumnDefinitions="Auto,260" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        RowSpacing="6" ColumnSpacing="6">
    <TextBlock Grid.Row="0" Classes="label" Text="Name" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" />

    <TextBlock Grid.Row="1" Classes="label" Text="Size test" />
    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TestBox" Width="260">
      <ComboBoxItem>Fits within W × H cm</ComboBoxItem>
      <ComboBoxItem>Longest side up to X cm</ComboBoxItem>
      <ComboBoxItem>Shortest side up to X cm</ComboBoxItem>
      <ComboBoxItem>Area up to X cm²</ComboBoxItem>
    </ComboBox>

    <TextBlock Grid.Row="2" Classes="label" Text="Width (cm)" x:Name="WidthLabel" />
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="WidthBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="3" Classes="label" Text="Height (cm)" x:Name="HeightLabel" />
    <TextBox Grid.Row="3" Grid.Column="1" x:Name="HeightBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="4" Classes="label" Text="Limit (cm)" x:Name="LimitLabel" />
    <TextBox Grid.Row="4" Grid.Column="1" x:Name="LimitBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="5" Classes="label" Text="Area (cm²)" x:Name="AreaLabel" />
    <TextBox Grid.Row="5" Grid.Column="1" x:Name="AreaBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="6" Classes="label" Text="Target ppi" />
    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TargetBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="7" Classes="label" Text="Leave alone from" />
    <TextBox Grid.Row="7" Grid.Column="1" x:Name="MinBox" Width="150" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="8" Classes="label" Text="Leave alone up to" />
    <TextBox Grid.Row="8" Grid.Column="1" x:Name="MaxBox" Width="150" HorizontalAlignment="Left" />

    <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="OkButton" Content="OK" Width="90" HorizontalContentAlignment="Center" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" Width="90" HorizontalContentAlignment="Center" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
