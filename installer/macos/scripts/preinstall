#!/bin/sh
# Runs as root before the payload is copied: stops the watcher daemon, the menu-bar helpers and open settings windows
# (their program files are replaced), makes sure the payload goes into a trusted data folder (an untrusted one is moved
# aside first, as on Windows) and removes the previous program files, so an upgrade leaves no stale files behind.
# Configuration and logs are never touched here.
#
# When the daemon itself runs this upgrade (/usr/sbin/installer is its child), booting it out here does not end the
# installer: the daemon's job has AbandonProcessGroup set.
set -u
SCRIPT_NAME=preinstall
. "$(dirname "$0")/common.sh"

# The job may not be loaded (first install, or stopped in the settings window): that is fine.
if launchctl bootout "system/$DAEMON_LABEL" 2>/dev/null; then
    say "stopped the watcher daemon"
else
    say "the watcher daemon was not loaded"
fi

for uid in $(gui_users) $(tray_users); do
    launchctl bootout "gui/$uid/$TRAY_LABEL" 2>/dev/null && say "stopped the menu-bar helper of user $uid"
done
# Whatever is left: helpers of users without a desktop session, and open settings windows.
pkill -f "$SETTINGS_PATTERN" 2>/dev/null && say "ended running copies of the settings app"

ensure_root || exit 1

# Program files of the previous version. Root was checked above; the app folder is replaced as a whole.
if [ -e "$ROOT/bin" ] || [ -L "$ROOT/bin" ]; then
    rm -rf "$ROOT/bin" || { say "ERROR: could not remove the previous '$ROOT/bin'"; exit 1; }
fi
if [ -e "$APP" ] || [ -L "$APP" ]; then
    rm -rf "$APP" || { say "ERROR: could not remove the previous '$APP'"; exit 1; }
fi
exit 0
